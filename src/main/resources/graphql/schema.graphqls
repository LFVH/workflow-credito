scalar Decimal

enum StatusProposta {
    RASCUNHO
    EM_ANALISE
    PENDENTE_DOCUMENTOS
    APROVADA
    REPROVADA
    CANCELADA
}

enum StatusContrato {
    GERADO
    ASSINADO
    ATIVO
    LIQUIDADO
    CANCELADO
}

type Proposta {
    id: ID!
    valor: Decimal!
    prazoMeses: Int!
    status: StatusProposta!
    motivo: String
    transicoesPossiveis: [StatusProposta!]!
    "Contrato gerado a partir desta proposta; null enquanto não houver."
    contrato: Contrato
}

"Contrato de crédito, gerado a partir de uma proposta aprovada."
type Contrato {
    id: ID!
    "Id da proposta que originou o contrato (referência por id)."
    propostaId: ID!
    "Valor aprovado, copiado da proposta no momento da geração."
    valor: Decimal!
    prazoMeses: Int!
    status: StatusContrato!
    motivo: String
    transicoesPossiveis: [StatusContrato!]!
}

type Query {
    proposta(id: ID!): Proposta

    """
    Propostas em ordem de criação, uma página por vez (paginação por cursor).
    Para a próxima página, passe em depoisDe o id da última proposta recebida.
    Página vazia: fim da lista.
    """
    propostas(
        "Id da última proposta da página anterior. Omitido: primeira página."
        depoisDe: ID
        "Tamanho da página, de 1 a 100. Omitido: 20."
        limite: Int
    ): [Proposta!]!

    contrato(id: ID!): Contrato
}

type Mutation {
    criarProposta(valor: Decimal!, prazoMeses: Int!): Proposta!
    enviarParaAnalise(id: ID!): Proposta!
    pedirDocumentos(id: ID!): Proposta!
    aprovarProposta(id: ID!): Proposta!
    reprovarProposta(id: ID!, motivo: String!): Proposta!
    cancelarProposta(id: ID!, motivo: String!): Proposta!

    "Gera o contrato de uma proposta APROVADA. Idempotente: se já existir, devolve o existente."
    gerarContrato(propostaId: ID!): Contrato!
    assinarContrato(id: ID!): Contrato!
    "Contrato ativo = dinheiro liberado. A partir daqui não cancela: só liquida."
    ativarContrato(id: ID!): Contrato!
    liquidarContrato(id: ID!): Contrato!
    cancelarContrato(id: ID!, motivo: String!): Contrato!
}
